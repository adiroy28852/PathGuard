# Optional: when set, the graph-backed findings can be summarized by an LLM.
# The attack-path query and remediation simulation always run in FalkorDB.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: use docker-compose.cloud.yml with a FalkorDB Cloud endpoint.
# Use falkors:// for TLS and URL-encode special characters in credentials.
# FALKORDB_URL=falkors://username:password@host:port
# FALKORDB_GRAPH=pathguard
